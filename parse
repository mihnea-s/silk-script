@test.unit
fun test_adder(ctx: test.Unit) {
    ctx.assertEqual(add(1, 2), 3);
}

@test.property
fun test_prop_adder(ctx: test.Property) {
    let a = ctx.Real();
    let b = ctx.Real();
    ctx.assertEqual(add(a, b), a + b);
}

@test.benchmark
fun test_adder_bench(ctx: test.Benchmark) {
    ctx.Record();
    add(5, 6);
    let perf = ctx.Finish();
    ctx.assertLess(perf.totalTime.asNano(), 4);
}

